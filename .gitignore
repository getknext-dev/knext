.output/
**/.output/

# Local scratch / planning artifacts (never part of the repo)
knext-plan-out/
.superteam/
# Knowledge-graph output. It was ignored only by one maintainer's *global*
# ~/.gitignore_global, which protects exactly one machine: on any other clone
# `graphify-out/` shows as untracked and is one `git add .` away from committing a
# multi-megabyte generated graph. It also made the repo's own `pnpm run lint` fail
# locally after any graphify run, because biome's `useIgnoreFile` reads .gitignore
# and never saw it.
graphify-out/
# Agent gate verdicts and per-task worktrees. Both are per-session artifacts of
# how the work was done, not the work. `.claude/worktrees/` was only ever ignored
# via `.git/info/exclude`, which is local to one clone and shared with nobody —
# so every other contributor saw it as untracked. Ignore both here instead.
.claude/verdicts/
.claude/worktrees/
.maturity-brief.md
.migration-spec.md
skills-lock.json

# npm/JS supply-chain gate (scripts/audit-published.mjs, v4-P3) — the per-package
# CycloneDX SBOMs are a CI artifact (uploaded by the release workflows), not source.
/sbom/

# e2e-deploy.sh local pack-once fallback (#147 A3-3 fix round 1) — packed
# adapter tarballs + the atomic staging dirs must never be committed.
**/.e2e-tarballs/
**/.e2e-tarballs.lock/
**/.e2e-pack.*/

# turbo prune output (docs dependency closure, CI Trivy scan)
.docs-closure/

# benchmarks/scale-to-zero-oke/run.sh default output — a per-run artifact
# against a live cluster, never checked in (#423).
benchmarks/**/results/
.vercel

# Stray Go build caches. `go test`/`go vet` can drop a `go-build<digits>/`
# GOCACHE directory in the repo root (992MB seen); it is regenerable build
# output and must never be committed.
go-build*/
