export declare function initRuntimeMetrics(registry: Registry, app?: string, collectDefaults?: boolean): KnextMetrics;
/** The initialised runtime metrics, or `undefined` before `initRuntimeMetrics`. */
export declare function getRuntimeMetrics(): KnextMetrics | undefined;
/** Reset the runtime singleton (tests only). */
export declare function resetRuntimeMetrics(): void;
/** Default port the child binds for its core metrics (supervisor scrapes it). */
export declare const CHILD_METRICS_PORT: number;
/**
 * Bind a tiny localhost HTTP server that serves `registry` at `/metrics`. Used
