/**
 * GENERATED BY the knext app scaffolder — `turbo gen zone` (in this repo) or
 * `kn-next create` (ADR-0048). Both emit this file byte-identically; a drift
 * guard pins that.
 *
 * The SHALLOW readiness/liveness endpoint (#910, ADR-0026/#338).
 *
 * knext's operator points BOTH the Knative readiness probe and the liveness
 * probe at this one path (`spec.healthCheckPath`, defaulting to
 * `/api/health`). Without this file a deployed app answers 404 there, so the
 * revision never reports Ready and liveness then restart-loops the pod.
 *
 * It is shallow BY CONSTRUCTION, and that is not laziness: readiness must
 * answer "is this process serving?", never "is every dependency awake?". knext
 * scales databases and caches to zero, so an asleep dependency is the NORMAL
 * state, and a probe that dialled one would flap readiness on every cold wake
 * and take the pod down with liveness. Deep dependency checks belong on a
 * separate path that nothing probes (`/api/health/deep` by the operator's
 * convention) and are read by alerting, not by Kubernetes.
 *
 * So: no imports, no I/O, no environment reads. Adding any of those to this
 * handler is a correctness regression, not a feature.
 */

// Never cached, never prerendered: a cached 200 would report a dead process as
// healthy, which is the one answer a probe must never be able to give.
export const dynamic = 'force-dynamic';

export function GET() {
    return new Response(JSON.stringify({ status: 'ok' }), {
        status: 200,
        headers: { 'content-type': 'application/json' },
    });
}
