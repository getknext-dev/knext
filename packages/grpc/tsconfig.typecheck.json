{
  // Typecheck gate: unlike tsconfig.json (the build config, which excludes
  // tests), this pulls the tests AND the fixture zone's generated code into
  // strict scope, so a generator change that emits a client which does not
  // type-check against the runtime reds here. `paths` points the generated
  // import of the runtime at its source (no build needed), and
  // fixtures/zone/server-only.d.ts and next-cache.d.ts stand in for Next.js's
  // `server-only` and `next/cache` (the real ones are built by the two-user test).
  // `types: ["bun"]` for the `bun:test` ambient module (TS7 does not
  // auto-include @types/*); rootDir widened (to packages/, for the two-user test's
  // shared fake Redis from core's test helpers) because nothing is emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"],
    "rootDir": "..",
    "paths": {
      "@getknext/grpc/runtime": ["./src/runtime.ts"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "e2e/z7-identity-kind/probe.ts",
    "e2e/z7-identity-kind/probe-lib.ts",
    "e2e/z7-identity-kind/key-needles.ts",
    "e2e/z7-identity-kind/zone-caller/build.ts",
    "fixtures/zone/src/generated/**/*.ts",
    "fixtures/zone/server-only.d.ts",
    "fixtures/zone/next-cache.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
