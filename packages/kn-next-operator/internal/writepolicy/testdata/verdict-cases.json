{
  "$comment": "Shared by the operator (internal/writepolicy) and by `knext doctor` (packages/kn-next/src/cli/doctor/checks/write-policy.ts): both must reach the same verdict on the same objects, so the self-check and the CLI cannot drift. Objects are shaped as the apiserver returns them for the rendered bundle (name prefix and namespace applied). Ops: remove-policy, remove-binding, set (target policy|binding, dotted path, value; arrays are replaced whole), identity (the operator's username; absent = the rendered one). The base policy carries the SHIPPED variables and validations verbatim (config/admission/secret-configmap-writes.yaml); a test in each language fails if the shipped CEL changes without this file and the check's canonical copy being updated.",
  "operatorUsername": "system:serviceaccount:kn-next-operator-system:kn-next-operator-controller-manager",
  "policy": {
    "apiVersion": "admissionregistration.k8s.io/v1",
    "kind": "ValidatingAdmissionPolicy",
    "metadata": {
      "name": "kn-next-operator-secret-configmap-writes"
    },
    "spec": {
      "failurePolicy": "Fail",
      "matchConstraints": {
        "resourceRules": [
          {
            "apiGroups": [""],
            "apiVersions": ["v1"],
            "operations": ["CREATE", "UPDATE", "DELETE"],
            "resources": ["secrets", "configmaps"]
          }
        ]
      },
      "matchConditions": [
        {
          "name": "request-is-from-the-operator",
          "expression": "request.userInfo.username == 'system:serviceaccount:' + 'kn-next-operator-system' + ':' + 'kn-next-operator-controller-manager'"
        }
      ],
      "variables": [
        {
          "name": "objectName",
          "expression": "request.operation == 'DELETE' ? oldObject.metadata.name : object.metadata.name"
        },
        {
          "name": "allowedSecretSuffixes",
          "expression": "['-knext-signing-key']"
        },
        {
          "name": "allowedConfigMapSuffixes",
          "expression": "['-knext-jwks']"
        },
        {
          "name": "allowedSecretType",
          "expression": "'Opaque'"
        },
        {
          "name": "allowedSuffixes",
          "expression": "request.resource.resource == 'secrets' ? variables.allowedSecretSuffixes : variables.allowedConfigMapSuffixes"
        },
        {
          "name": "newOwners",
          "expression": "request.operation == 'DELETE' || !has(object.metadata.ownerReferences) ? [] : object.metadata.ownerReferences"
        },
        {
          "name": "oldOwners",
          "expression": "request.operation == 'CREATE' || !has(oldObject.metadata.ownerReferences) ? [] : oldObject.metadata.ownerReferences"
        },
        {
          "name": "zoneOwners",
          "expression": "request.operation == 'CREATE' ? variables.newOwners : variables.oldOwners"
        }
      ],
      "validations": [
        {
          "expression": "variables.allowedSuffixes.exists(s, variables.objectName.endsWith(s) && size(variables.objectName) > size(s))",
          "messageExpression": "'the knext operator may not ' + request.operation.lowerAscii() + ' the ' + request.resource.resource + ' object \"' + variables.objectName + '\": it writes only the per-zone signing key and JWKS'",
          "reason": "Forbidden"
        },
        {
          "expression": "request.resource.resource != 'secrets' || request.operation == 'DELETE' || dyn(object).type == variables.allowedSecretType",
          "message": "the knext operator may write only Opaque Secrets: a service-account-token or any other Secret type under an allowed name would let it mint a credential",
          "reason": "Forbidden"
        },
        {
          "expression": "variables.allowedSuffixes.exists(s, variables.zoneOwners.exists(r, has(r.controller) && r.controller == true && r.kind == 'NextApp' && r.apiVersion.startsWith('apps.kn-next.dev/') && r.name + s == variables.objectName))",
          "message": "the knext operator may write only an object its zone's NextApp controls: it needs a controller ownerReference to that NextApp, named after the object's zone",
          "reason": "Forbidden"
        },
        {
          "expression": "request.operation != 'UPDATE' || variables.newOwners == variables.oldOwners",
          "message": "the knext operator may not change an object's ownerReferences: a write that swaps, drops or forges its owner is refused",
          "reason": "Forbidden"
        }
      ]
    }
  },
