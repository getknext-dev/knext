          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_pod_status_phase, namespace)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
