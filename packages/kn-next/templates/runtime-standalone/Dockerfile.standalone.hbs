# syntax=docker/dockerfile:1
#
# knext — node/bun STANDALONE runtime image (ADR-0055).
#
# NOT emitted by `knext create` — the scaffolder only walks `templates/app/`.
# This is the ADR-0055 image recipe, staged under `templates/runtime-standalone/`
# into the build context at `knext deploy` / `preview` time instead
# (`stageStandaloneBuildContext`) — `knext build` does NOT stage or build this
# recipe; only `deploy.ts`/`preview.ts` call `stageStandaloneBuildContext` and
# `dockerBuildxArgs`. See the BUILD-CONTEXT REQUIREMENT note below for why that
# split matters.
#
# This is the image for the STANDALONE shape (`next build` with
# output:'standalone'), as opposed to the vinext single-executable image
# (`Dockerfile.hbs`). Per ADR-0055 the IMAGE declares how to start itself: the
# ENTRYPOINT is a supervisor entry (`knext-standalone-entry.mjs` importing
# `@getknext/core/internal/node-server`), and the operator selects image + env +
# probes and leaves the container Command `nil`. The supervisor owns SIGTERM
# drain, the eager `:9464` metrics endpoint, the Cache-Control preload and the
# compile-cache diagnostics that a forced `bun run server.js` command discarded.
#
# RUNTIME AXIS = BUILD TARGET, NOT A TEMPLATE VARIABLE. The scaffolder's template
# renderer (`renderScaffold`) is a pure variable substitutor that throws on any
# leftover placeholder, so this file carries no template mustache at all. The two
# runtimes are two `--target` stages, each with its own digest-pinned base and its
# own correct
# ENTRYPOINT (`node file` is NOT `node run file`). The build wiring picks:
#   docker build --target standalone-bun  .     # bun runtime
#   docker build --target standalone-node .     # node runtime
#
# Both base digests are REUSED verbatim from the repo's existing pins
# (apps/file-manager/Dockerfile, .github/workflows/supply-chain.yml) so the base
# CVE surface is scanned in one place. A whole-base `apk upgrade --no-cache`
# BEFORE the link libs clears the base-layer CVE lag between the pinned digest and
# the branch's current patch (same rationale as Dockerfile.hbs); package versions
# are deliberately NOT pinned — a pinned version goes stale like the digest.
#
# BUILD-CONTEXT REQUIREMENT, owed to the CLI-wiring that renders and builds
# this file (`stageStandaloneBuildContext` + `dockerBuildxArgs`): whichever
# `.dockerignore` bounds that context must NOT exclude `.next/standalone`,
# `.next/static` or `node_modules/@getknext/core` — the CLI-shipped
# `templates/app/.dockerignore.hbs` (paired with the OTHER, vinext
# `Dockerfile.hbs`) excludes all three, which is why the staging function
# writes its OWN per-Dockerfile `.dockerignore` (`standaloneDockerignore()`)
# rather than reusing the app's. This template lives OUTSIDE `templates/app`
# (`templates/runtime-standalone/`) so `knext create` does not emit it:
# `templates/app` is walked and rendered into EVERY scaffolded app with no
# allowlist, and this recipe is selected by build/deploy-time config
# (`config.build`/`config.runtime`), not by scaffold-time choice.

# ---------------------------------------------------------------------------
# deps — resolves the supervisor's OWN runtime dependency closure (pino,
# prom-client, @opentelemetry/api — the packages `@getknext/core/dist/adapters/
# node-server.js` and its `./metrics` companion actually load, statically or
# eagerly) via a REAL package-manager install, INSIDE the build.
#
# Why not just COPY these from the build context's own node_modules: this
# repo's own dev install (bun, isolated/pnpm-style linker) never materializes
# them as plain directories under a shared node_modules root at all — they are
# symlinks into a content-addressed `node_modules/.bun` store — and even a
# flat/hoisted npm install cannot be assumed to put a dependency's OWN
# transitive deps (pino alone pulls 11) at any fixed, guessable path. Resolving
# them HERE, with a real installer, is the only way this Dockerfile can name a
# COPY source that is actually correct rather than merely plausible — and it
# is a bonus, not a cost, for the native-module host/libc hazard the sibling
# `.dockerignore.hbs` warns about (copying a HOST node_modules can ship
# binaries built for the wrong libc): none of these three packages are native,
# but resolving inside a linux/musl-compatible stage is strictly safer than
# trusting whatever the build host's package manager laid out.
#
# Versions match @getknext/core's own package.json ranges (packages/kn-next/
# package.json) so this stage tracks whatever @getknext/core actually depends
# on rather than drifting from it independently.
#
# Discarded stage: its npm binary NEVER reaches the bun runtime layer below
# (only `/deps/node_modules` is copied out) — the bun stage stays npm-free.
#
# @getknext/lib (the DB-pool-drain / image-cache-sync object-store client —
# @cerbos/grpc + minio + pg, by far the heaviest graph either call site can
# reach) is DELIBERATELY NOT installed here. Both call sites load it lazily
# and FAIL OPEN when it is absent, by design, not by accident of this
# Dockerfile: `db-drain.ts`'s `drainDbPools` catches a load failure, logs a
# warning and returns — "draining must not throw" — and
# `image-cache-sync.ts`'s `startImageCacheSync` never attempts the import
# unless `STORAGE_BUCKET` is set (it returns `{ stop: () => {} }` first). So
# its absence degrades functionality (no DB-pool drain, no image-cache sync)
# but never crash-loops the ENTRYPOINT — the class of bug this template fixes.
# Installing its native closure is real, disproportionate scope for a
# template-only increment (ADR-0055 action item 1) and is left to the
# CLI-wiring increment, which controls the actual build context.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS standalone-deps

WORKDIR /deps

RUN npm install --omit=dev --no-save --no-audit --no-fund \
    pino@^9.6.0 prom-client@^15.1.3 @opentelemetry/api@^1.9.0

# ---------------------------------------------------------------------------
# bun runtime — oven/bun ships bun ONLY (no node, no npm), which is what keeps
# the built-image Trivy job green (it reds on the node base's bundled-npm CVEs).
# ---------------------------------------------------------------------------
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS standalone-bun

RUN apk upgrade --no-cache && apk add --no-cache libstdc++ libgcc

WORKDIR /app

# C5 path algebra (ADR-0055). The REAL Next standalone tree lands under
# .next/standalone, so its own server.js is /app/.next/standalone/server.js — the
# non-colliding STANDALONE_SERVER_PATH the supervisor spawns. It is NEVER copied
# to /app root, where its server.js would collide with the /app/server.js shim
# below and the wrong one would win silently.
COPY .next/standalone /app/.next/standalone
COPY .next/static /app/.next/standalone/.next/static
COPY public /app/.next/standalone/public

# The Next server, COMPILED: `knext build` (build: turbopack + runtime: bun)
# compiles .next/standalone/server.js into a Bun single executable WITH
# bytecode and verifies the bytecode is really there. Bytecode caching is
# mandatory for every runtime cell; on Bun this executable is how the cell
# gets it. It sits INSIDE the standalone tree because it anchors on its own
# directory (it replaces `bun server.js`, not the tree — Next still loads the
# route chunks from .next/server by path). The supervisor spawns it via
# STANDALONE_SERVER_EXEC below; there is no silent fallback to `bun server.js`:
# a build that did not produce it fails this COPY.
COPY knext-standalone-exec-linux-x64 /app/.next/standalone/knext-standalone-exec

# The runtime-agnostic supervisor the ENTRYPOINT shim imports, PLUS its own
# resolved dependency closure. The WHOLE package (not just dist/adapters) —
# tsup's ESM chunk-splitting puts shared code the entry statically imports
# (e.g. the logger chunk) at dist/ ROOT, outside dist/adapters, so a narrower
# copy left that import unresolved and the container crash-loops on boot.
COPY --from=standalone-deps /deps/node_modules /app/node_modules
COPY node_modules/@getknext/core /app/node_modules/@getknext/core

# The SAME shim at BOTH paths: the ENTRYPOINT target, and the R3 compat shim the
# CURRENT operator command (`bun run server.js`) names — so old-operator ×
# new-image still reaches the supervisor.
COPY knext-standalone-entry.mjs /app/knext-entry.mjs
COPY knext-standalone-entry.mjs /app/server.js

USER 65532:65532

ENV PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    STANDALONE_SERVER_PATH=/app/.next/standalone/server.js \
    STANDALONE_SERVER_EXEC=/app/.next/standalone/knext-standalone-exec

EXPOSE 3000

ENTRYPOINT ["bun", "run", "/app/knext-entry.mjs"]

# ---------------------------------------------------------------------------
# bun runtime, SELF-CONTAINED (N2, #1457, opt-in via `selfContained: true` /
# `--self-contained`) — ships ONLY the compiled executable + `public/` +
# `.next/static`: no `.next/standalone` tree, no `node_modules` anywhere in
# the image (neither `.next/standalone/node_modules` nor `/app/node_modules`).
#
# The disk-mode `standalone-bun` stage above still needs `.next/standalone`
# beside the executable because Next loads its route chunks from there by
# COMPUTED path at request time (`standalone-exec-build.ts`'s own doc comment:
# "the executable replaces the script, not the tree"). Self-contained mode is
# the other point on that same axis: `knext-standalone-exec-linux-x64` here was
# compiled WITH `--self-contained 1` (`standalone-compile.mjs`), so `.next` and
# every module its route chunks load are embedded INSIDE the executable's own
# virtual filesystem (`$bunfs`) — only `.next/static` (bulky, served by path,
# never executed) and `public/` stay on real disk beside it, at the paths the
# embedded entry's disk aliases expect (`STANDALONE_DIR_BINDING` = the
# executable's own directory, i.e. `/app`; `distDir` defaults to `.next`, so
# static must sit at `/app/.next/static` and public at `/app/public` — see
# `standalone-exec-entry.mjs`'s `selfContainedPrologue`).
#
# NO SUPERVISOR SHIM IN THIS STAGE, ON PURPOSE. The disk-mode stages' ENTRYPOINT
# is `knext-standalone-entry.mjs` (importing `@getknext/core/internal/node-server`),
# which spawns the server as a CHILD process so it can drain it on SIGTERM, and
# needs pino/prom-client/@opentelemetry/api — resolved via the `standalone-deps`
# npm-install stage and copied into `/app/node_modules` above. That whole
# dependency closure is exactly what "no node_modules" rules out. Per the N2
# decision (jev pick: fold 0.87 vs sidecar 0.13, confidence 0.73 — a sidecar
# still needs node_modules unless rewritten dependency-free, at which point it
# gains nothing over folding the same dependency-free logic into the one
# process that already exists), the SIGTERM-drain + `:9464` metrics behaviour is
# folded directly into the executable as a THIRD baked-in preload
# (`standalone-self-contained-supervisor.cjs`, alongside the two the disk-mode
# entry also carries) — baked in only when `--self-contained 1` compiles this
# exact executable, never for the disk-mode ones above. So the ENTRYPOINT here
# execs the compiled binary directly: one process, no shim, no spawn.
#
# `/app/server.js` further down IS a shim, but a different one for a different
# reason (B2, round-2 fix, #1457) — it exists ONLY because the operator's
# `Command` override does not yet know this shape and would CrashLoop without
# it. It is not a supervisor: it adds no SIGTERM/metrics logic of its own (the
# executable it execs already owns that) and no `node_modules`.
#
# NOT YET SUPPORTED HERE: a `native/` directory for native addons (e.g. sharp),
# unlike the vinext single-executable image (`templates/app/Dockerfile.hbs`),
# which stages one with an integrity manifest. `standalone-compile.mjs`'s
# self-contained planner currently FAILS the build outright on any `.node` file
# under the traced tree rather than staging it to a native dir (see
# `standalone-native-addon-guard.test.ts`) — extending it to stage native
# addons the way the vinext target already does is real, separate scope, not
# a Dockerfile change, and is left as follow-up (an app using `next/image` with
# sharp cannot use this target yet; it can still use the disk-mode stages
# above, or the vinext self-contained binary, which does support `native/`).
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS standalone-bun-self-contained

RUN apk upgrade --no-cache && apk add --no-cache libstdc++ libgcc

WORKDIR /app

# Static assets only — the app tree itself lives inside the executable.
COPY public /app/public
COPY .next/static /app/.next/static

# The self-contained executable: `.next` + every module its route chunks load
# are embedded inside it (compiled WITH `--self-contained 1`). No
# `.next/standalone` COPY, no deps stage, no `/app/node_modules` — this stage
# has neither.
COPY knext-standalone-exec-linux-x64 /app/knext-standalone-exec

# R3 compat shim (B2, N2 round-2, #1457) — NOT a supervisor, NOT part of the
# fold decision above. The operator hardcodes
# `Command: ["bun", "run", "server.js"]` for any NextApp with
# `spec.build != "vinext"` and `spec.runtime == "bun"`
# (`nextapp_controller.go`'s `containerCommand` branch), and it does not yet
# know this shape exists — unlike vinext, which the operator already leaves
# `Command: nil` for. Extending the operator/CR to do the same for
# self-contained is a CRD/operator change (trigger-class per
# `.claude/rules/workflow.md`) and is tracked as a separate issue rather than
# made here. Without this file, an operator-rendered pod runs
# `bun run server.js` against an image with no `server.js` and CrashLoops —
# this shim IS that file: it just execs the compiled binary next to it and
# forwards stdio/signals/exit code. It adds no `node_modules` and no new
# runtime dependency — `bun` is already present because this STAGE'S OWN
# base image ships it (see the `FROM` line above), not something this file
# pulls in.
COPY knext-self-contained-server-shim.js /app/server.js

USER 65532:65532

ENV PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production

EXPOSE 3000

# No shell, no supervisor, no spawned child on the NORMAL boot path — the
# compiled executable IS the server, and (per the fold decision above) also
# owns its own SIGTERM drain and `:9464` metrics endpoint directly. This
# ENTRYPOINT is what actually runs a container whose Command is nil (`docker
# run` with no override, or a future operator that knows this shape).
# TODAY's operator forces `Command: ["bun", "run", "server.js"]` for this
# runtime regardless of shape, which bypasses this ENTRYPOINT and runs
# `/app/server.js` (the compat shim above) instead — see its comment.
ENTRYPOINT ["/app/knext-standalone-exec"]

# ---------------------------------------------------------------------------
# node runtime — node:22-alpine. Same layout, same shim, node ENTRYPOINT.
# ---------------------------------------------------------------------------
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS standalone-node

RUN apk upgrade --no-cache && apk add --no-cache libstdc++ libgcc

WORKDIR /app

# C5 path algebra — identical to the bun stage; the standalone tree's real
# server.js stays at the non-colliding /app/.next/standalone/server.js and never
# lands on /app root beside the shim.
COPY .next/standalone /app/.next/standalone
COPY .next/static /app/.next/standalone/.next/static
COPY public /app/.next/standalone/public

# Identical closure to the bun stage above — see its comments for why the
# WHOLE package (not just dist/adapters) and the deps-stage node_modules.
COPY --from=standalone-deps /deps/node_modules /app/node_modules
COPY node_modules/@getknext/core /app/node_modules/@getknext/core

COPY knext-standalone-entry.mjs /app/knext-entry.mjs
COPY knext-standalone-entry.mjs /app/server.js

# The bake driver (see its own header for why this shape is in-process, not
# spawn-then-signal): it IMPORTS the standalone server.js itself, so warming
# it and flushing its V8 compile cache happen in the one process that
# actually compiled it.
COPY knext-compile-cache-bake.mjs /app/knext-compile-cache-bake.mjs

# The cache directory must belong to the RUNTIME user before the bake runs —
# see the ordering note beside the bake RUN step below.
RUN mkdir -p /app/.next/standalone/.next/compile-cache \
 && chown 65532:65532 /app/.next/standalone/.next/compile-cache

USER 65532:65532

ENV PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    STANDALONE_SERVER_PATH=/app/.next/standalone/server.js \
    NODE_COMPILE_CACHE=/app/.next/standalone/.next/compile-cache

# Bytecode caching is MANDATORY on every runtime cell (founder rule). Next's
# generated server.js is not code this repo owns, so there is no entry-level
# BAKE flag to set the way `Dockerfile.vinext-node.hbs` does for its own
# entry — instead the driver above stands in for it, in a THROWAWAY process
# that never ships (only the cache directory it wrote does).
#
# Measured against this recipe's own real build (linux/amd64, the minimal
# fixture standalone-drain-app — 7 routes, node:22-alpine): a healthy bake
# produces ~1.35 MB across 476 files, and NODE_DEBUG_NATIVE=COMPILE_CACHE
# shows 522 accepted entries at boot (388 under node_modules/next/dist alone
# — Next's own framework internals, present regardless of app size — plus the
# app's own route chunks under .next/server). The floor below (256 KiB) stays
# well under that measured minimum while catching a truncated/empty flush far
# earlier than the previous 64 KiB floor did — the cache would look present
# and do nothing, so the build fails instead of shipping it.
ARG KNEXT_COMPILE_CACHE_MIN_BYTES=262144

# The path the bake warms — MUST match `knext.config.ts`'s `healthCheckPath`
# (default `/api/health`). `knext deploy`/`preview` pass this as a
# `--build-arg` when the app configures a custom path (`knext build` does
# NOT stage or build this recipe at all — see the file header); an app with
# no `/api/health` route and no custom `healthCheckPath` would otherwise fail
# THIS BUILD, not just its Knative probe.
ARG KNEXT_HEALTH_CHECK_PATH=/api/health

# THE BAKE. It runs AS 65532, after the USER line above, and that ordering is
# load-bearing: node keys the cache subdirectory by the uid that wrote it, so
# a cache baked as root is never read by the non-root runtime — present on
# disk, 0% hit rate. PORT/HOSTNAME are overridden for this step only, to a
# loopback address the driver's own warm-up requests reach directly; the
# ENV defaults above (0.0.0.0:3000) are what the shipped container actually
# binds at runtime.
RUN PORT=8901 HOSTNAME=127.0.0.1 KNEXT_WARM_PATH="${KNEXT_HEALTH_CHECK_PATH}" node /app/knext-compile-cache-bake.mjs \
 && bytes=$(find /app/.next/standalone/.next/compile-cache -type f -exec cat {} + | wc -c) \
 && echo "compile cache baked: ${bytes} bytes in $(find /app/.next/standalone/.next/compile-cache -type f | wc -l) file(s)" \
 && if [ "${bytes}" -lt "${KNEXT_COMPILE_CACHE_MIN_BYTES}" ]; then \
      echo "compile-cache bake produced ${bytes} bytes, below the floor of ${KNEXT_COMPILE_CACHE_MIN_BYTES}" >&2; \
      exit 1; \
    fi

EXPOSE 3000

# `node file`, never `node run file` — `node --run` executes a package.json
# script, not a file, so it would never boot the supervisor.
ENTRYPOINT ["node", "/app/knext-entry.mjs"]
