/**
 * NOT emitted by `knext create` — the scaffolder only walks
 * `templates/app/`. Staged into the build context at `knext deploy` /
 * `preview` time instead (`stageStandaloneBuildContext`,
 * `templates/runtime-standalone/`, paired with `Dockerfile.standalone.hbs`).
 * `knext build` does NOT stage or build this recipe. See that file's
 * header for the ADR-0055 image shape this belongs to.
 *
 * knext STANDALONE-NODE compile-cache BAKE driver.
 *
 * Bytecode caching is mandatory for every runtime cell (founder rule). On the
 * standalone-node target the process that matters is Next's OWN generated
 * `server.js` — code this repo does not own and cannot add a bake mode to the
 * way the vinext node entry (`knext-node-entry.mjs`) does for itself. This
 * file is the analog for that shape: a throwaway driver the Dockerfile RUNs
 * once, at `docker build`, that BECOMES the server process (imports it
 * in-process rather than spawning a child) so warming it and flushing its V8
 * compile cache both happen in the ONE process V8 actually compiled into.
 *
 * Why in-process, not spawn-then-signal: Node only flushes
 * `NODE_COMPILE_CACHE` reliably on an EXPLICIT `process.exit()` call (or a
 * natural, empty-event-loop exit) — the 'exit' event that the flush hook
 * hangs off. A raw SIGTERM/SIGINT with no handler installed terminates the
 * process via the OS default disposition, without ever reaching that event,
 * so a spawn-then-kill bake would silently ship an EMPTY cache. Importing
 * `server.js` here means this driver's own `process.exit()`, after warming,
 * is what flushes it — no signal races, nothing to get wrong.
 *
 * Ordering (mirrors the Dockerfile comment): this RUN step executes AFTER
 * `USER 65532:65532`, and that is load-bearing — Node keys the compile-cache
 * subdirectory by the uid that wrote it, so a bake run as root produces a
 * cache the non-root runtime uid never reads (present on disk, 0% hit rate).
 *
 * Env this driver reads (all supplied by the Dockerfile's RUN step):
 *   STANDALONE_SERVER_PATH  the standalone server.js to import and warm
 *                            (same var the supervisor spawns at runtime).
 *   PORT / HOSTNAME          bound during the bake only; a loopback address
 *                            picked to avoid colliding with anything else in
 *                            the build sandbox.
 *   KNEXT_WARM_PATH          comma-separated paths to fetch before flushing
 *                            (default the shallow `/api/health`, which needs
 *                            no database).
 *
 * Exit 0 only once every warm path answered 2xx and the cache was flushed;
 * exit 1 otherwise, which fails the `docker build` — the same fail-closed
 * contract `Dockerfile.vinext-node.hbs`'s bake enforces. UNCONDITIONALLY
 * strict (#1299) — there is no env-var escape hatch in these shipped bytes.
 * The official compat harness's fixtures are deliberately built to 404/500
 * (a rendered 404/500 still exercises the server runtime the cache must
 * cover), so the harness needs to tolerate a non-2xx warm without failing
 * the deploy — that tolerance now lives OUTSIDE this file entirely, in
 * `scripts/e2e-bake-accept.mjs`, a harness-owned wrapper that spawns this
 * driver as a child and re-derives the tolerant verdict from its stdout +
 * exit code. This driver does not know that wrapper exists, reads no
 * variable it sets, and behaves identically whether run directly (a real
 * user's `docker build`) or through it (a harness night) — see that
 * script's header for the full design and why the actual baked bytes are
 * unaffected either way.
 */

import { flushCompileCache, getCompileCacheDir } from "node:module";
import { connect } from "node:net";

const serverPath = process.env.STANDALONE_SERVER_PATH;
if (!serverPath) {
    console.error(
        "[knext] compile-cache bake FAILED: STANDALONE_SERVER_PATH is not set",
    );
    process.exit(1);
}

const PORT = process.env.PORT ?? "3000";
const HOST = process.env.HOSTNAME ?? "127.0.0.1";
const WARM_PATHS = (process.env.KNEXT_WARM_PATH ?? "/api/health")
    .split(",")
    .map((p) => p.trim())
    .filter(Boolean);

// HOSTNAME may be a bind address like 0.0.0.0; loopback is always
// reachable from the same process regardless of what the server bound.
const CONNECT_HOST = HOST === "0.0.0.0" || HOST === "::" ? "127.0.0.1" : HOST;

function warmUrl(path) {
    return `http://${CONNECT_HOST}:${PORT}${path}`;
}

// #1572: READINESS is a TCP accept on $PORT — never an HTTP request through
// the app's routing. Two measured next@16.3.5 shapes made an HTTP readiness
// probe unreliable under this bake's 127.0.0.1 bind:
//   - redirect-rewrite-dynamic{,-basepath}: `GET /` answers `307 Location: /`
//     (a self-redirect); a following fetch() threw "redirect count exceeded",
//     which the probe read as "not listening yet" until the deadline;
//   - middleware-rewrite-dynamic / server-actions-redirect-middleware-rewrite:
//     the middleware rewrite is proxied externally, hangs up, and the FIRST
//     response (a 500) arrives only after ~30s — half the deadline, before the
//     warm has even started.
// The server is up the moment it accepts a connection (Next's standalone
// server holds early requests until its handlers are ready). What the app
// ANSWERS is the warm's job below, which still requires a real HTTP status.
function tcpAccepts(timeoutMs) {
    return new Promise((resolve, reject) => {
        const socket = connect({ host: CONNECT_HOST, port: Number(PORT) });
        const timer = setTimeout(() => {
            socket.destroy();
            reject(new Error(`connect timed out after ${timeoutMs}ms`));
        }, timeoutMs);
        socket.once("connect", () => {
            clearTimeout(timer);
            socket.destroy();
            resolve();
        });
        socket.once("error", (err) => {
            clearTimeout(timer);
            socket.destroy();
            reject(err);
        });
    });
}

// The WARM uses `redirect: "manual"` and follows redirects by hand (below),
// so a redirect loop resolves to its real 3xx status instead of a throw.

// Captured BEFORE server.js is imported: Next patches `globalThis.fetch` in
// the server process (its data-cache instrumentation), and this driver IS that
// process. Measured on next@16.3.5: after the first request, a
// `redirect: "manual"` call through the patched fetch never settles. The
// bake's own requests are plain HTTP clients — they must not go through it.
const nativeFetch = globalThis.fetch;
const MAX_REDIRECTS = 10;

async function waitForServer(deadlineMs) {
    const start = Date.now();
    const deadline = start + deadlineMs;
    let lastError = "no attempt made";
    for (;;) {
        try {
            await tcpAccepts(2_000);
            console.log(
                `[knext bake] standalone server answered after ${Date.now() - start}ms`,
            );
            return;
        } catch (err) {
            // not listening yet — keep the reason
            lastError = err?.message ?? String(err);
        }
        if (Date.now() > deadline) {
            throw new Error(
                `standalone server did not answer within ${deadlineMs}ms (last error: ${lastError})`,
            );
        }
        await new Promise((r) => setTimeout(r, 100));
    }
}

// Follows redirects by hand (at most MAX_REDIRECTS hops, stopping at the
// first revisited URL) so a legitimate redirect still lands on its 2xx target,
// while a loop resolves to the REAL 3xx status it answered with — a numeric
// verdict — instead of a thrown fetch error.
async function fetchFollowing(url) {
    const seen = new Set([url]);
    let current = url;
    for (let hop = 0; ; hop++) {
        const res = await nativeFetch(current, { redirect: "manual" });
        const location = res.headers.get("location");
        await res.body?.cancel();
        if (res.status < 300 || res.status >= 400 || !location) {
            return { status: res.status, loop: false };
        }
        const next = new URL(location, current).href;
        if (seen.has(next) || hop + 1 >= MAX_REDIRECTS) {
            return { status: res.status, loop: true, to: next };
        }
        seen.add(next);
        current = next;
    }
}

async function main() {
    // Importing this CJS entry executes its top-level side effects (binding
    // $PORT) exactly as running it directly would — the same code path the
    // supervisor spawns at runtime, just in THIS process instead of a child.
    await import(serverPath);

    // #1572: 30_000ms was measured too tight for a real, if less common, app
    // shape — a fixture whose route tree includes Proxy/middleware-driven
    // dynamic redirects/rewrites can take longer than 30s to cold-boot on a
    // loaded machine (this IS the uncached, cold-JIT boot the bake exists to
    // warm, so it is the slowest one this file ever sees). Evidence: the
    // node-lane compat-suite shards carrying the upstream
    // redirect-rewrite-dynamic(.test.ts)/redirect-rewrite-dynamic-basepath
    // fixtures failed this exact deadline identically under both turbopack and
    // webpack, independent of NEXTJS_REF (reproduced on both v16.3.5 and
    // v16.2.0 runs) — ruling out a version regression — while the SAME shards
    // passed cleanly on other nights, ruling out a permanent incompatibility.
    // That shape (fixture-deterministic, run-to-run intermittent) is a timing
    // floor set too tight, not a broken cache: doubling it costs a real user
    // nothing (the loop below still exits the instant the server answers) and
    // gives genuinely slower-booting apps the headroom a loaded CI runner (or
    // host) needs. Still fail-closed — a truly hung server still throws.
    await waitForServer(60_000);

    let allOk = true;
    for (const path of WARM_PATHS) {
        const t0 = Date.now();
        try {
            const res = await fetchFollowing(warmUrl(path));
            allOk &&= res.status >= 200 && res.status < 300;
            console.log(`WARMED:${path} status=${res.status} ms=${Date.now() - t0}`);
            if (res.loop) {
                console.error(
                    `[knext bake] warm path ${path} is a redirect loop (${res.status} → ${res.to}) — not a 2xx`,
                );
            }
        } catch (err) {
            allOk = false;
            console.log(
                `WARMED:${path} status=error ms=${Date.now() - t0} (${err?.message ?? err})`,
            );
        }
    }

    console.log(`COMPILE_CACHE:${getCompileCacheDir?.() ?? "none"}`);

    if (!allOk) {
        console.error(
            "[knext] compile-cache bake FAILED: a warm path did not answer 2xx",
        );
        flushCompileCache?.();
        process.exit(1);
    }

    // The explicit flush, and the process.exit() that follows it, are what
    // this driver exists for — see the header comment.
    flushCompileCache?.();
    process.exit(0);
}

main().catch((err) => {
    console.error("[knext] compile-cache bake FAILED:", err);
    flushCompileCache?.();
    process.exit(1);
});
