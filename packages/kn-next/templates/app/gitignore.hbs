# {{ name }} — generated by `knext create`.

# ── Secrets and local credentials ────────────────────────────────────────────
# The runtime reads config from Kubernetes Secrets via env, never from a file
# in the image — nothing here is needed to build or deploy. Committing one of
# these is a credential leak, not just clutter.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.npmrc
.netrc
kubeconfig
.kube/

# ── Dependencies and build output ────────────────────────────────────────────
node_modules
.next
.output
.vinext
# Anchored to the app root (a leading `/`): `dist`/`build`/`server` are all
# valid Next.js route-segment or source-directory names (e.g.
# src/app/build/page.tsx, src/server/db.ts) — an unanchored bare pattern
# matches a directory with that name at ANY depth and would silently drop
# real source from version control.
/dist
/build
*.tsbuildinfo

# Compiled single-executables — ~60-90 MB each, and build OUTPUT: `kn-next
# build` (or `bun build --compile`) regenerates them. Two different binary
# basenames, one per build target (the standalone target's is NOT a prefix of
# the vinext target's, so both patterns are needed).
knext-exec*
knext-standalone-exec*
/server

# ── Test, coverage and editor noise ──────────────────────────────────────────
/coverage
.nyc_output
*.log
.DS_Store
.idea
.vscode
*.swp
