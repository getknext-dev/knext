// KNEXT_NODE_ENTRY_MARKER: 4
// Bump this whenever this file's runtime behavior changes (a Cache-Control
// rule, a header, a new env var it reads). `kn-next doctor` compares this
// number against the copy scaffolded into an app's own directory — an app
// created before a bump keeps running the OLD behavior silently (#1356) until
// its knext-node-entry.mjs is replaced with the current template. Marker
// history: 1 = pre-#1353 (no deployed Cache-Control normalization on this
// entry); 2 = #1353 added it (`applyVinextDeployDefault` +
// `cacheControlMiddleware`, imported from `response-cache-control.mjs`).
/**
 * GENERATED BY the knext app scaffolder — `kn-next create`.
 *
 * The Nitro server entry for `build: 'vinext'` + `runtime: 'node'`. The bun
 * target uses `knext-bun-entry.mjs`, which calls Bun's own APIs and exits 1
 * under node; this is its node twin. It re-provides the same platform
 * contract vinext cannot get from Next's adapter hooks — shallow health,
 * `:9464` metrics, draining in-flight requests on SIGTERM — over `srvx/node`
 * and `node:http`, sharing every decision with the bun entry through
 * `runtime-contract.mjs`.
 *
 * Do not rename it. `vite.config.ts` points nitro's `entry` at this exact path
 * when `kn-next.config.ts` says `runtime: 'node'`.
 *
 * Env-injection contract (operator-supplied), as the bun entry:
 *   PORT, HOSTNAME, METRICS_PORT (default 9464), SHUTDOWN_GRACE_MS (default
 *   25000), KNEXT_MAX_REQUEST_BYTES, KNEXT_WARM_PATH, KNEXT_EAGER_WARM.
 * Plus one build-time switch:
 *   KNEXT_COMPILE_CACHE_BAKE=1  boot, warm KNEXT_WARM_PATH, flush the V8 compile
 *                      cache (NODE_COMPILE_CACHE) to disk, drain and exit 0 —
 *                      or exit 1 if any warm path did not answer 2xx. The image
 *                      runs this once at `docker build` so every pod, the first
 *                      one included, starts with the cache populated.
 */

// MUST be first: nitro's own default entries open with this import, and it is
// what keeps vinext's route chunks in the build graph when `entry` is replaced.
import '#nitro/virtual/polyfills';
import { createServer } from 'node:http';
import { flushCompileCache, getCompileCacheDir } from 'node:module';
// Image optimization is intercepted here for the same reason as in the bun
// entry (vinext's own `/_next/image` path is dead off Cloudflare). No `sharp`
// is passed: uncompiled, the optimizer resolves sharp itself at first use and
// FAILS OPEN — an image without a loadable sharp serves the original, with one
// warning — so a missing native addon can never stop the server from booting.
import { handleImageRequest } from '@getknext/core/internal/vinext-image-optimizer';
// The deployed Cache-Control rule (`public, max-age=0, must-revalidate` instead
// of Next's origin `s-maxage=…`), applied to each Response before srvx writes it.
// The `node:http` preload cannot do it here: srvx/node writes headers as a flat
// array, which the preload does not rewrite. Off with
// KNEXT_CACHE_CONTROL_NORMALIZE=0.
import {
  applyVinextDeployDefault,
  cacheControlMiddleware,
} from '@getknext/core/internal/response-cache-control';
import { useNitroApp } from 'nitro/app';
import { serve } from 'srvx/node';
// vinext's `after()` hands its work to the request's EXECUTION CONTEXT
// (`ctx.waitUntil`). On Cloudflare the platform supplies one; under nitro's
// node server nothing does, so without this an `after()` callback is
// fire-and-forget — measured: a SIGTERM right after the response exited 0 with
// the callback never run. Each request below runs inside a context whose
// `waitUntil` is the runtime contract's, so the SIGTERM drain awaits it.
import { runWithExecutionContext } from 'vinext/shims/request-context';
import {
  createGracefulShutdown,
  createMetricsState,
  drainPending,
  METRICS_CONTENT_TYPE,
  METRICS_MAX_REQUEST_BYTES,
  observeRequest,
  recordStartupComplete,
  renderMetrics,
  resolveBindHost,
  resolveMaxRequestBytes,
  waitUntil,
} from './runtime-contract.mjs';

const PORT = Number(process.env.PORT ?? 3000);
// k8s sets HOSTNAME=<pod-name>; only an explicit bind/loopback address is
// honoured, anything else binds 0.0.0.0 (see resolveBindHost).
const HOSTNAME = resolveBindHost(process.env);
const METRICS_PORT = Number(process.env.METRICS_PORT ?? 9464);
const GRACE_MS = Number(process.env.SHUTDOWN_GRACE_MS ?? 25_000);
const REQUEST_CAP = resolveMaxRequestBytes(process.env);
const BAKE = process.env.KNEXT_COMPILE_CACHE_BAKE === '1';

// vinext's own deploy Cache-Control switch, on by default (it covers responses
// vinext computes itself, e.g. a fallback page's first request, which carries no
// header for the middleware to rewrite). vinext reads it per request.
applyVinextDeployDefault(process.env);

// biome-ignore lint/correctness/useHookAtTopLevel: useNitroApp() is Nitro's server-app accessor, not a React hook — the "use" prefix is coincidental.
const nitro = useNitroApp();
const metrics = createMetricsState();
const EXECUTION_CONTEXT = { waitUntil };

// ── App listener — Nitro's real request pipeline via srvx/node ──────────────
// The same `serve` path nitro's default node entry uses, so requests get the
// srvx request-context augmentation route matching depends on. srvx's own
// signal handling is off: OUR drain below owns the exit. On node, srvx
// enforces `maxRequestBodySize` as the body is READ (a 413 once the cap is
// crossed) rather than before the handler runs as Bun does — same cap,
// different moment.
const appSrvx = serve({
  port: PORT,
  hostname: HOSTNAME,
  fetch: nitro.fetch,
  maxRequestBodySize: REQUEST_CAP.bytes,
  gracefulShutdown: false,
  silent: true,
  middleware: [
    // Outermost, so every response below passes through it.
    cacheControlMiddleware(process.env),
    // Rate / errors / duration for the :9464 scrape. A throw is recorded as a
    // 5xx and re-thrown, never swallowed.
    async (_req, next) => {
      metrics.inflight++;
      const startedNs = process.hrtime.bigint();
      const elapsed = () => Number(process.hrtime.bigint() - startedNs) / 1e9;
      try {
        // `after()`/waitUntil work is registered with the drain (see the
        // import note). One shared context object: it only carries waitUntil.
        const res = await runWithExecutionContext(EXECUTION_CONTEXT, () => next());
        observeRequest(metrics, res?.status ?? 200, elapsed());
        return res;
      } catch (err) {
        observeRequest(metrics, 500, elapsed());
        throw err;
      } finally {
        metrics.inflight--;
      }
    },
    async (req, next) => {
      const optimized = await handleImageRequest(req, {
        fetchSource: (path) => nitro.fetch(new Request(new URL(path, req.url))),
      });
      return optimized ?? next();
    },
  ],
});
// node's listen is asynchronous; wait for the bind so nothing below (the
// startup log, the warm, a bake) runs against an unbound port.
await appSrvx.ready();
const appServer = {
  port: appSrvx.node?.server?.address()?.port ?? PORT,
  stop: (force) => appSrvx.close(force),
};

// ── In-process Prometheus :9464 on node:http ────────────────────────────────
const metricsHttp = createServer((req, res) => {
  // Same fixed cap as the bun entry: this listener answers one GET, and the
  // app's configurable cap must never re-open it.
  if (Number(req.headers['content-length'] ?? 0) > METRICS_MAX_REQUEST_BYTES) {
    res.writeHead(413).end();
    return;
  }
  if (req.method === 'GET' && new URL(req.url ?? '/', 'http://x').pathname === '/metrics') {
    res.writeHead(200, { 'content-type': METRICS_CONTENT_TYPE });
    res.end(renderMetrics(metrics));
    return;
  }
  res.writeHead(404).end('Not Found');
});
try {
  await new Promise((resolve, reject) => {
    metricsHttp.once('error', reject);
    metricsHttp.listen(METRICS_PORT, HOSTNAME, resolve);
  });
} catch (err) {
  console.error(
    `[knext] failed to bind the metrics listener on :${METRICS_PORT}` +
      (err?.code ? ` (${err.code})` : '') +
      ' — if this is EADDRINUSE, another listener owns the port; on Knative, queue-proxy' +
      ' binds :9091 whenever request metrics are enabled. Run `kn-next doctor`' +
      ' (metrics-port check), or move METRICS_PORT off the queue-proxy-owned ports.',
  );
  throw err;
}
const metricsServer = {
  port: metricsHttp.address().port,
  stop: () =>
    new Promise((resolve) => {
      metricsHttp.closeAllConnections?.();
      metricsHttp.close(() => resolve());
    }),
};

// Startup-order signal: both listeners are bound as of this line.
recordStartupComplete(metrics);
console.log(`LISTENING:${appServer.port} METRICS:${metricsServer.port}`);
// Diagnosable-in-the-logs half of the #1356 staleness check: `kn-next doctor`
// compares KNEXT_NODE_ENTRY_MARKER against the packaged template's copy
// file-locally, but this file itself has no way to know which version of
// @getknext/core is installed at boot (it is a standalone scaffolded file,
// not one that re-reads its own template at runtime) — printing its own
// marker at least lets an operator correlate a running pod's behavior
// against a specific scaffold generation from `kubectl logs` alone, without
// needing shell access to the app's source tree.
console.log('NODE_ENTRY_MARKER:4');
// Which compile cache this process is using — the image-baked one unless
// something injected NODE_COMPILE_CACHE over it. `none` means V8 compiles
// every module from source on this boot.
console.log(`COMPILE_CACHE:${getCompileCacheDir?.() ?? 'none'}`);
if (REQUEST_CAP.warning) {
  console.warn(`REQUEST_BYTE_CAP: ${REQUEST_CAP.source.toUpperCase()} — ${REQUEST_CAP.warning}`);
}
console.log(
  `REQUEST_BYTE_CAP:${REQUEST_CAP.bytes ?? 'none'} METRICS_BYTE_CAP:${REQUEST_CAP.metricsBytes} (${REQUEST_CAP.source})`,
);

// ── SIGTERM / SIGINT graceful drain ─────────────────────────────────────────
const shutdown = createGracefulShutdown({
  appServers: [appServer],
  metricsServer,
  drainTasks: drainPending,
  graceMs: GRACE_MS,
  log: (m) => console.log(m),
  exit: (code) => {
    // Persist whatever V8 compiled during this process. At `docker build`
    // (the bake) this is what writes the cache the image ships; on a pod it
    // is a no-op when the baked entries were accepted unchanged.
    flushCompileCache?.();
    process.exit(code);
  },
});
process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));

// ── Eager app-graph warmup (and the bake) ────────────────────────────────────
// Nitro reaches the application through a lazy import evaluated on the first
// matched request; warming it here moves that cost off the first user. In bake
// mode the warm is also what makes V8 compile the app's functions, so the
// cache it flushes covers more than the module's top level.
const WARM_PATHS = (process.env.KNEXT_WARM_PATH ?? '/api/health')
  .split(',')
  .map((p) => p.trim())
  .filter(Boolean);
if (process.env.KNEXT_EAGER_WARM !== '0' || BAKE) {
  (async () => {
    let allOk = true;
    for (const path of WARM_PATHS) {
      const warmT0 = Date.now();
      try {
        // Inside the execution context, like a live request: `after()` work a warm
        // route schedules registers with the drain, so the bake / SIGTERM awaits it.
        const res = await runWithExecutionContext(EXECUTION_CONTEXT, () =>
          nitro.fetch(new Request(`http://127.0.0.1:${appServer.port}${path}`)),
        );
        // Read the body to its end, as a live response is: vinext settles a warm
        // route's after() work only once its response body has been consumed, so an
        // unread body leaves that work pending and the drain would wait it out.
        await res.arrayBuffer().catch(() => {});
        allOk &&= res.status >= 200 && res.status < 300;
        console.log(`WARMED:${path} status=${res.status} ms=${Date.now() - warmT0}`);
      } catch (err) {
        allOk = false;
        console.log(`WARMED:${path} status=error ms=${Date.now() - warmT0} (${err?.message ?? err})`);
      }
    }
    if (BAKE) {
      if (!allOk) {
        // A bake that could not serve its own warm path would ship an image
        // that cannot either. Fail the `docker build` here, loudly.
        console.error('[knext] compile-cache bake FAILED: a warm path did not answer 2xx');
        flushCompileCache?.();
        process.exit(1);
      }
      shutdown('BAKE');
    }
  })();
}
