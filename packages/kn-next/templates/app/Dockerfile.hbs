# GENERATED BY `kn-next create` (#407). Build context = the directory the
# standalone output is traced from (the nearest lockfile above this app), so the
# COPY paths below match the `.next/standalone/{{ standalonePrefix }}` layout
# `next build` produces for THIS app — the same path its seam guard asserts.
FROM node:22-alpine AS builder
WORKDIR /repo
COPY . .
WORKDIR /repo/{{ standalonePrefix }}
RUN npm ci && npm run build

FROM node:22-alpine AS runner
ENV NODE_ENV=production
# Knative injects PORT; the standalone server binds HOSTNAME:PORT.
ENV HOSTNAME=0.0.0.0
# Bytecode cache: cuts cold start on the scale-to-zero 0→1 wake.
ENV NODE_COMPILE_CACHE=/app/.compile-cache
WORKDIR /app
COPY --from=builder /repo/{{ standalonePrefix }}.next/standalone ./
COPY --from=builder /repo/{{ standalonePrefix }}.next/static ./{{ standalonePrefix }}.next/static
COPY --from=builder /repo/{{ standalonePrefix }}public ./{{ standalonePrefix }}public
EXPOSE 8080
CMD ["node", "{{ standalonePrefix }}server.js"]
