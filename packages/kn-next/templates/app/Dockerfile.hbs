# GENERATED BY `kn-next create` (#407).
#
# BUILD CONTEXT: the directory `next build` traces this app from — the OUTERMOST
# lockfile-bearing ancestor of the app (the rule Next's own
# `findRootDirAndLockFiles` uses). Build from THAT directory:
#
#     docker build -f {{ standalonePrefix }}Dockerfile .
#
# The context is load-bearing, not incidental: Next nests the standalone output
# under the app's path relative to that root, so every COPY below, the `start`
# script, and the seam guard's expected path are all the SAME
# `{{ standalonePrefix }}` — one inference, not two guesses.
#
# Base image is DIGEST-PINNED (not the floating node:22-alpine tag) so an
# unreviewed upstream push cannot change the CVE surface of the image you sign
# (security.md, "Supply chain"). The human-readable tag lives in this comment
# because Docker rejects trailing comments on a FROM line; refresh both together:
#   docker buildx imagetools inspect node:22-alpine
# node:22-alpine
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS builder
WORKDIR /repo
COPY . .
# Install at the CONTEXT ROOT — that is where the root marker is, and none of
# `npm ci` / `pnpm install` / `yarn install` walk up to find one. The command
# matches the marker `kn-next create` actually found at that root, which is a
# lockfile or a `pnpm-workspace.yaml`.
#
# If the command below is `pnpm install` WITHOUT `--frozen-lockfile`, the CONTEXT
# ROOT above holds no `pnpm-lock.yaml`, so the install cannot be frozen and this
# image is not reproducible — it resolves fresh versions on every build. Commit a
# `pnpm-lock.yaml` AT THAT ROOT and re-run `kn-next create` (or edit this line) to
# get the frozen form. A lockfile further down the tree does not apply: the install
# runs here, not there.
RUN {{ installCmd }}
# …but BUILD in the app directory. In a workspace those are different places.
WORKDIR /repo/{{ standalonePrefix }}
RUN npm run build

# Produce a self-contained @getknext/core for the runner. The CMD boots the knext
# runtime entry (`@getknext/core/internal/node-server`), but Next's standalone
# output is import-graph driven and NOTHING in app code imports that module — so
# neither it nor its runtime deps land in `.next/standalone`. Without this stage
# the CMD resolves to MODULE_NOT_FOUND and the pod crash-loops at boot.
WORKDIR /knext-runtime
RUN npm init -y >/dev/null 2>&1 && npm install --no-audit --no-fund --omit=dev @getknext/core@{{ version }}

# node:22-alpine (same digest as the builder — see the FROM above)
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runner
ENV NODE_ENV=production
# Knative injects PORT; the standalone server binds HOSTNAME:PORT.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
# Bytecode cache: cuts cold start on the scale-to-zero 0→1 wake.
ENV NODE_COMPILE_CACHE=/app/.compile-cache
WORKDIR /app
COPY --from=builder /repo/{{ standalonePrefix }}.next/standalone ./
COPY --from=builder /repo/{{ standalonePrefix }}.next/static ./{{ standalonePrefix }}.next/static
COPY --from=builder /repo/{{ standalonePrefix }}public ./{{ standalonePrefix }}public
# The knext runtime package + its prod deps, so the CMD's package specifier
# resolves (the standalone trace omits it — see the builder stage).
COPY --from=builder /knext-runtime/node_modules/ ./node_modules/
EXPOSE 3000

# Drop privileges — node:22-alpine already ships a non-root `node` user (uid 1000).
USER node

# Runtime entry: boot the knext runtime, NOT a bare `node server.js`.
#
# That entry is the ONLY thing that installs the SIGTERM handler which drains
# in-flight requests and runs Next's `after()` callbacks before exit
# (security.md, "Graceful shutdown"), and it serves the Prometheus metrics
# sidecar. Bare-exec'ing the standalone server bypasses BOTH, so requests are
# dropped on every scale-to-zero. It spawns server.js itself, told where to find
# it via STANDALONE_SERVER_PATH (whose default assumes the single-app layout).
CMD ["sh", "-c", "export STANDALONE_SERVER_PATH=\"${STANDALONE_SERVER_PATH:-{{ standalonePrefix }}server.js}\"; exec node -e \"import('@getknext/core/internal/node-server')\""]
