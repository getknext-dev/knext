# syntax=docker/dockerfile:1
#
# knext — vinext single-executable image (ADR-0048).
#
# This is the image for the ONLY supported target: `build: vinext` +
# `runtime: bun`, compiled with `bun build --compile --minify --bytecode`.
#
# Why it looks nothing like the retired node/standalone Dockerfile: there is no
# node_modules to copy, no `server.js` to spawn, and no supervisor. The binary
# IS the server — every route, the nitro runtime and V8 bytecode are baked in.
# That is what buys the measured 61 ms cold start against node-standalone's
# 884 ms (docs/benchmarks/vinext-bun14-single-exec-2026-08-27.md).
#
# Build context is the app root, so `.output/public` resolves. The binary is
# built OUTSIDE this file — by `kn-next build`, which pins the target triple to
# the image arch — and passed in, because cross-compiling inside the image
# would force a Bun toolchain into the runtime layer for no benefit.
#
# BINARY must be a musl target for this base (`bun-linux-x64-musl` /
# `bun-linux-arm64-musl`). A glibc binary exits 1 here with no useful message.
# Overridden by `kn-next deploy` with the arch it built for:
#   docker build --build-arg BINARY=knext-exec-linux-arm64 .
ARG BINARY=knext-exec-linux-x64

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

# The two libraries a Bun-compiled binary links against. Nothing else is needed
# — no node, no npm, no package manager in the shipped image.
RUN apk add --no-cache libstdc++ libgcc

WORKDIR /app

ARG BINARY
# NEVER name this after a runtime (`bun`, `node`, `deno`): knext's asset-root
# resolver classifies a compiled binary by basename, and those names make it
# read the build tree's assets instead of the image's.
COPY ${BINARY} /app/server
COPY .output/public /app/.output/public

# sharp's native module, if the app uses `next/image`.
#
# It CANNOT live inside the binary: a compiled executable resolves modules only
# from its own embedded graph, so sharp's addon is unreachable from in there —
# and embedding the `.node` does not help either, because the OS cannot load a
# native library from a path inside the binary. It is opened by absolute path
# instead, from a real file next to the executable.
#
# `kn-next build` stages this directory. If it is absent the image still runs and
# `/_next/image` returns the ORIGINAL image unresized — working, but every photo
# ships at full size.
#
# Keep the directory layout: the addon finds its image library by a relative
# path, so flattening the tree breaks it.
#
# `native/.integrity.json` travels INSIDE this directory and must not be stripped
# out: it is the sha256-per-file record `kn-next build` wrote from the lockfile,
# and the binary refuses to `dlopen` anything that disagrees with it. Copying the
# directory ships it — that is why the manifest lives in the tree rather than
# beside it, so no second COPY line can be forgotten.
COPY native /app/native

# Fail here rather than at the first `/_next/image` request. Without the manifest
# the binary still runs, warns, and loads the addon UNVERIFIED (older images must
# not brick) — which is a state to catch at build time, not to discover in a log.
RUN test -f /app/native/.integrity.json || { \
      echo "native/.integrity.json missing — run 'kn-next build' to stage a pinned native tree" >&2; \
      exit 1; \
    }

# Non-root, matching the distroless convention used across knext images.
USER 65532:65532

ENV PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production

EXPOSE 3000

# No shell, no supervisor, no `sh -c`. One process, which is also what makes
# SIGTERM draining the entry's own job rather than a parent's.
CMD ["/app/server"]
