/**
 * {{ name }} — vinext build config.
 *
 * knext builds your app with vinext and compiles it into a single Bun
 * executable — a smaller image and fast warm-request throughput, with the whole
 * server precompiled to bytecode so the process itself starts in tens of
 * milliseconds. (Note: on a scale-to-zero Knative cluster the first request
 * after an idle period is dominated by pod scheduling — a few seconds — not by
 * that process start, so treat the fast boot as an efficiency win, not a
 * sub-second cold-start guarantee.)
 *
 * This file is deliberately small. If you have used `create-vinext-app`, the
 * shape is the same minus the Cloudflare Workers pieces — no `wrangler`, no
 * `@cloudflare/vite-plugin`, no KV/CDN adapters. knext targets Knative on
 * Kubernetes instead, so the server is a Bun binary rather than a Worker.
 *
 * Set `runtime: 'node'` in kn-next.config.ts and the same app builds for Node
 * instead: nitro's `node` preset, served by `knext-node-entry.mjs`, run
 * uncompiled with a V8 compile cache baked into the image
 * (`Dockerfile.vinext-node`). The runtime is read from kn-next.config.ts —
 * the same file `knext build` and `knext deploy` read — so the preset can
 * never disagree with the image the CLI builds.
 */

import { nitro } from 'nitro/vite';
import vinext from 'vinext';
import { defineConfig } from 'vite';
import knext from './kn-next.config';

// 'node' only when asked for; anything else is the default Bun target.
const onNode = knext.runtime === 'node';

export default defineConfig({
  plugins: [
    vinext({
      // ISR/data cache → Redis (#953). vinext never reads next.config's
      // `cacheHandler` (that is a webpack/turbopack mechanism); its hook is
      // THIS plugin option. It generates a registration module every server
      // entry runs, and vinext's default origin-managed ISR strategy then
      // stores page artifacts through the registered data cache and serves
      // HIT/STALE from it. Deleting this block does not fail the build — the
      // app silently falls back to a per-pod in-memory cache and the
      // provisioned Redis stays empty, which is exactly how the gap shipped
      // unnoticed once.
      cache: {
        data: { adapter: '@getknext/core/internal/vinext-cache-adapter' },
      },
    }),
    nitro({
      // Bun by default, because that artifact is compiled with
      // `bun build --compile`. The two presets are NOT interchangeable: the bun
      // entry calls Bun's global `serve()` at module top level, so a bun build
      // exits 1 under node — which is why the preset follows `runtime`.
      preset: onNode ? 'node' : 'bun',

      // knext's own Nitro server entry, one per runtime. vinext is
      // Vite/rolldown and cannot see knext's adapter hooks, so this wrapper
      // re-provides what the platform needs: the health endpoint, `:9464`
      // metrics, and draining in-flight requests on SIGTERM before the pod
      // goes away.
      entry: onNode ? './knext-node-entry.mjs' : './knext-bun-entry.mjs',

      // REQUIRED — do not remove without reading this.
      //
      // Nitro on rolldown reads `output.codeSplitting`, not rollup's
      // `manualChunks`. Setting `inlineDynamicImports` makes it disable code
      // splitting (see nitro/dist/vite.mjs).
      //
      // Why it matters: when the server bundle splits, vinext's Next-compat
      // shims land in a second chunk that re-exports a symbol declared in no
      // emitted module. The bundle then fails on any runtime — the server 500s
      // with "not declared in this file" — and `bun build --compile` refuses
      // it. One chunk, no split, no failure.
      rollupConfig: { output: { inlineDynamicImports: true } },
    }),
  ],
});
