import type { NextConfig } from "next";

/**
 * {{ name }} — Next.js options.
 *
 * Standalone-by-default: knext builds this app with plain `next build`
 * (Turbopack, the ambient Next 16.2+ default — see the `build` script in
 * package.json). `output: 'standalone'` is what makes that build emit a
 * self-contained `.next/standalone/server.js` — the knext runtime image's
 * supervisor (`knext-standalone-entry.mjs`) spawns that server and drains it
 * on SIGTERM. Deleting `output: 'standalone'` does not fail the build
 * locally, but `knext deploy` has nothing to COPY into the runtime image
 * and fails loudly instead.
 *
 * `adapterPath` wires the official Next.js Deployment Adapter
 * (`./next-adapter.ts` → `@getknext/core/adapter`) — this is what injects the
 * edge-safe `IgnorePlugin` fence `src/instrumentation.ts` depends on, and
 * what reports build completion back to `knext build`. Building with
 * `next build` and NOT wiring this adapter is a silent correctness gap, not a
 * build failure — don't delete it.
 *
 * A HISTORICAL NOTE, since it is easy to reintroduce by accident: combining
 * `adapterPath` with `output: 'standalone'` under Turbopack threw `ENOENT:
 * .next/next-server.js.nft.json` at `next build` time on stable Next 16.3.0
 * through 16.3.4 — a confirmed upstream regression, not a knext
 * defect and not a permanent Turbopack/adapter architecture gap. Fixed
 * upstream in 16.3.5 (pinned below), confirmed by a live local repro of
 * this exact config. See
 * https://github.com/getknext-dev/knext/issues/1372 for the full trace and
 * bisection. `knext build`/`deploy` still carry a pre-build guard for the
 * confirmed-affected range
 * (`checkTurbopackAdapterStandaloneRegression`, `project-build.ts`) — it
 * only fires below 16.3.5, so it does not gate this app's pinned version; it
 * exists for apps that pin an OLDER Next this scaffold did not generate.
 */
const nextConfig: NextConfig = {
    // Asset prefix is injected by `knext deploy` from `knext.config.ts`
    // storage settings. In dev mode (`next dev`) ASSET_PREFIX is unset, so
    // assets serve locally.
    assetPrefix: process.env.ASSET_PREFIX || "",
    // Skew protection: the build id IS the deploy tag. `knext deploy`
    // exports KNEXT_BUILD_ID = the tag before `next build`, so
    // `_next/static/<BUILD_ID>/`, the image tag and the prefix the
    // asset-retention GC deletes by are one value, and a client on an old
    // build detects the new one by its build id. Do NOT set `deploymentId`
    // here: on Next 16.2.11+ any deployment id makes Next ignore
    // `generateBuildId` and write a constant build id, which `knext deploy`
    // refuses. NEXT_DEPLOYMENT_ID is only a fallback for builds that still
    // receive it (Next before 16.2.11 with an older knext CLI). Returning
    // null in `next dev` falls back to Next's default id.
    generateBuildId: () => process.env.KNEXT_BUILD_ID || process.env.NEXT_DEPLOYMENT_ID || null,
    output: "standalone",
    // Redis-backed cache handler for Knative (multi-pod consistency).
    // Falls back to in-memory when REDIS_URL is not set.
    cacheHandler: new URL("./cache-handler.js", import.meta.url).pathname,
    // Per-pod memory caches diverge across pods — Redis is the one cache.
    cacheMaxMemorySize: 0,
    // next/image optimization via sharp (in deps + the runtime
    // image). remotePatterns is an EXPLICIT allowlist — empty means local
    // images only (no open optimizer / SSRF). Add trusted hosts as needed.
    images: {
        formats: ["image/avif", "image/webp"],
        remotePatterns: [],
    },
    // The official Next.js Deployment Adapter (top-level since next 16.2).
    adapterPath: new URL("./next-adapter.ts", import.meta.url).pathname,
    // `instrumentation.ts` is compiled for BOTH the
    // `nodejs` AND `edge` runtimes. Its Node-only body lives in
    // `src/instrumentation-node.ts`, loaded via a dynamic import guarded at
    // RUNTIME — but webpack/turbopack STATICALLY trace that import into the
    // edge compile too. The load-bearing edge exclusion (an `IgnorePlugin`
    // replacing `instrumentation-node` with an empty module on the edge
    // compile ONLY) is PLATFORM-OWNED: the knext adapter's `modifyConfig`
    // injects it (see `./next-adapter.ts` above). This app deliberately does
    // NOT hand-write that webpack hook.
};

export default nextConfig;
