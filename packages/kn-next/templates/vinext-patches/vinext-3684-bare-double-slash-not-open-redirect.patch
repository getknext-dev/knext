knext bundled fix for vinext 1.0.1 (dist output)
Upstream: https://github.com/cloudflare/vinext/pull/3684
What it fixes: isOpenRedirectShaped() rejected ANY pathname starting with // (or its backslash/percent-encoded equivalents) as a protocol-relative open-redirect shape, including a bare '//' with nothing after it. A redirect target needs something host-like after the double slash to be dangerous -- '//' alone has no host segment, and Next.js serves it as the index route, not a 404.
Retire: delete this file (and its manifest entry) when the pinned vinext is >= the first
release that includes cloudflare/vinext#3684.
Ported by hand from the upstream src change to the published 1.0.1 dist files.
Applied by `knext vinext-patches` (runs from the app's postinstall and before `knext build`).

--- a/dist/server/open-redirect.js
+++ b/dist/server/open-redirect.js
@@ -5,17 +5,23 @@
 *
 * A pathname is considered "open redirect shaped" when its first segment,
 * after decoding backslashes and encoded delimiters, would cause a browser
-* to resolve a `Location` containing the pathname as protocol-relative.
+* to resolve a `Location` containing the pathname as protocol-relative —
+* which requires something after the leading double slash that looks like a
+* host. A bare double slash (nothing after it, in either form) has no
+* host-like segment to redirect to: Next.js serves "//" as the index route,
+* not a 404.
 */
 function isOpenRedirectShaped(rawPathname) {
 	if (!rawPathname.startsWith("/")) return false;
 	const afterSlash = rawPathname.slice(1);
-	if (afterSlash.startsWith("/") || afterSlash.startsWith("\\")) return true;
-	if (afterSlash.length >= 3 && afterSlash[0] === "%") {
+	let rest = null;
+	if (afterSlash.startsWith("/") || afterSlash.startsWith("\\")) rest = afterSlash.slice(1);
+	else if (afterSlash.length >= 3 && afterSlash[0] === "%") {
 		const encoded = afterSlash.slice(0, 3).toLowerCase();
-		if (encoded === "%5c" || encoded === "%2f") return true;
+		if (encoded === "%5c" || encoded === "%2f") rest = afterSlash.slice(3);
 	}
-	return false;
+	if (rest === null) return false;
+	return rest.length > 0;
 }
 //#endregion
 export { isOpenRedirectShaped };
