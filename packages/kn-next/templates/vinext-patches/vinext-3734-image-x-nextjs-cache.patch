+async function handleNitroImageOptimization(request, nitroFetch, allowedWidths, imageConfig, basePath = "") {
+	const origin = new URL(request.url).origin;
+	let sourceMaxAge = 0;
+	const response = await handleConfiguredImageOptimization(request, async (assetPath) => {
+		const source = await nitroFetch(new Request(new URL(assetPath, origin)));
+		const headers = new Headers();
+		for (const name of NITRO_IMAGE_SOURCE_HEADERS) {
+			const value = source.headers.get(name);
+			if (value !== null) headers.set(name, value);
