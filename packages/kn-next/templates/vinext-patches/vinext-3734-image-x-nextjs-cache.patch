+	const sourceUrl = new URL(new URL(request.url).searchParams.get("url") ?? "", "http://n").pathname;
+	const isStatic = sourceUrl.startsWith(`${basePath}/_next/static/media`) || sourceUrl.startsWith(`${basePath}/_next/static/immutable/media`);
+	response.headers.set("Cache-Control", isStatic ? IMAGE_CACHE_CONTROL : `public, max-age=${Math.max(sourceMaxAge, DEFAULT_IMAGE_MINIMUM_CACHE_TTL)}, must-revalidate`);
