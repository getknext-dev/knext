knext bundled fix for vinext 1.0.1 (dist output)
Upstream: https://github.com/cloudflare/vinext/pull/3226
What it fixes: Nitro builds: a `turbopack.resolveExtensions` list without `.mjs` no longer hides Nitro's own preset entry (the build failed to resolve it).
Retire: delete this file (and its manifest entry) when the pinned vinext is >= the first
release that includes cloudflare/vinext#3226.
Ported by hand from the upstream src change to the published 1.0.1 dist files.
Applied by `knext vinext-patches` (runs from the app's postinstall and before `knext build`).

--- a/dist/index.js
+++ b/dist/index.js
@@ -1924,7 +1924,7 @@
 					config.optimizeDeps.include = mergeStringArrayValues(config.optimizeDeps.include, PAGES_CLOUDFLARE_WORKER_OPTIMIZE_DEPS_INCLUDE);
 					config.optimizeDeps.exclude = mergeOptimizeDepsExclude(config.optimizeDeps.exclude ?? [], VINEXT_OPTIMIZE_DEPS_EXCLUDE, PAGES_CLOUDFLARE_WORKER_OPTIMIZE_DEPS_EXCLUDE);
 				}
-				const configuredExtensions = name === "client" ? nextConfig.resolveExtensions : nextConfig.serverResolveExtensions;
+				const configuredExtensions = name === "client" ? nextConfig.resolveExtensions : hasNitroPlugin && name === "nitro" ? null : nextConfig.serverResolveExtensions;
 				const extensions = configuredExtensions === null ? buildViteResolveExtensions(config.resolve?.extensions) : normalizeViteResolveExtensions(configuredExtensions);
 				config.resolve ??= {};
 				config.resolve.extensions = extensions;
