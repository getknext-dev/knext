{
 "apiVersion": "serving.knative.dev/v1",
 "kind": "Service",
 "metadata": {
  "name": "fm-vinext",
  "namespace": "default",
  "labels": {
   "dev.knext.purpose": "vinext-bunexec-full-app-spike"
  }
 },
 "spec": {
  "template": {
   "metadata": {
    "annotations": {
     "autoscaling.knative.dev/max-scale": "2",
     "autoscaling.knative.dev/min-scale": "0",
     "autoscaling.knative.dev/scale-down-delay": "5m"
    }
   },
   "spec": {
    "containerConcurrency": 0,
    "containers": [
     {
      "env": [
       {
        "name": "HOSTNAME",
        "value": "0.0.0.0"
       },
       {
        "name": "NODE_ENV",
        "value": "production"
       },
       {
        "name": "GCS_BUCKET_NAME",
        "value": "knative-next-assets-banna"
       },
       {
        "name": "GCS_BUCKET_KEY_PREFIX",
        "value": "file-manager/"
       },
       {
        "name": "REDIS_URL",
        "value": "redis://redis.default.svc.cluster.local:6379"
       },
       {
        "name": "REDIS_KEY_PREFIX",
        "value": "file-manager/"
       },
       {
        "name": "DATABASE_URL",
        "valueFrom": {
         "secretKeyRef": {
          "key": "DATABASE_URL",
          "name": "filemanager-scalezeropg"
         }
        }
       },
       {
        "name": "KN_APP_NAME",
        "value": "file-manager"
       },
       {
        "name": "OTEL_TRACING_ENABLED",
        "value": "true"
       },
       {
        "name": "OTEL_TRACES_SAMPLER_ARG",
        "value": "1"
       },
       {
        "name": "KNEXT_DB_POOL_MAX",
        "value": "8"
       },
       {
        "name": "KNEXT_WARM_PATH",
        "value": "/"
       }
      ],
      "image": "me-abudhabi-1.ocir.io/axfqznklsd2t/file-manager@sha256:08443c7a9a05d71520c38f5ea6631a8184b78c7a111f1e644a79392efc845662",
      "name": "user-container",
      "ports": [
       {
        "containerPort": 8080,
        "protocol": "TCP"
       }
      ],
      "readinessProbe": {
       "successThreshold": 1,
       "tcpSocket": {
        "port": 0
       }
      },
      "resources": {}
     }
    ],
    "enableServiceLinks": false,
    "imagePullSecrets": [
     {
      "name": "ocir-secret"
     }
    ],
    "timeoutSeconds": 300
   }
  },
  "traffic": [
   {
    "latestRevision": true,
    "percent": 100
   }
  ]
 }
}