# Plain-k8s (OKE) image for the docs site. Build with the REPO ROOT as context:
#   docker build --platform linux/amd64 -f apps/docs/Dockerfile.oke .
#
# The docs app depends on `@getknext/core` via `workspace:*`, which npm cannot
# resolve (EUNSUPPORTEDPROTOCOL) — so an `npm install` inside apps/docs alone,
# as this file used to do, cannot build. The build stage therefore mirrors
# apps/docs/Dockerfile: bun drives the workspace and the libraries build first.
# Only the RUNTIME differs: a node image serving nitro's `node` preset.
#
# NITRO_PRESET=node is load-bearing. The app's default preset is `bun`, whose
# entry serves through `Bun.serve`/`srvx/bun`; that output builds fine and then
# fails at runtime on a `node:22-alpine` base. `node` selects nitro's own entry.
# The workflow smoke-boots this image before it is pushed.
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS build
# tsup shells out to `tsc` for the .d.ts pass; node is build-stage only.
RUN apk add --no-cache nodejs libstdc++ libgcc
WORKDIR /repo
COPY . .
RUN bun install --frozen-lockfile
# Order matters: docs imports the libraries' dist.
RUN bun run --filter "@getknext/lib" build
RUN bun run --filter "@getknext/db" build
RUN bun run --filter "@getknext/core" build
WORKDIR /repo/apps/docs
RUN bunx fumadocs-mdx
RUN NITRO_PRESET=node ./node_modules/.bin/vite build
# Both halves: the entry exists AND it is not the bun entry.
RUN test -f .output/server/index.mjs \
    && ! grep -q 'metricsServer' .output/server/index.mjs \
    || (echo "vite build did not produce a node-preset .output/server/index.mjs" && exit 1)

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS run
WORKDIR /app
# nitro's node-server reads HOST, not Next.js's HOSTNAME. Both are set: HOSTNAME
# is what the old `next start` used and is left so the deploy manifests that
# reference it keep working.
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0 HOSTNAME=0.0.0.0
# Whole-base upgrade (the repo convention: no per-package version pins, which go
# stale like the digest). No curl: the healthcheck below uses node itself.
RUN apk upgrade --no-cache
# The base image's bundled npm/corepack/yarn carry HIGH/CRITICAL JS CVEs that
# `apk upgrade` cannot patch, and nothing at runtime needs them.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY --from=build /repo/apps/docs/.output ./.output
EXPOSE 3000
USER 65532:65532
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 CMD ["node", "-e", "fetch('http://localhost:3000/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", ".output/server/index.mjs"]
